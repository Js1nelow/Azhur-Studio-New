# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="YOUR_APP_URL_HERE"

# MAX_BOT_TOKEN: The API token for Max Messenger bot integration
# Get your token from Max Bot platform
MAX_BOT_TOKEN="YOUR_MAX_BOT_TOKEN_HERE"
MAX_CHANNEL_ID="YOUR_CHANNEL_ID_HERE"

# reCAPTCHA keys — get from https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY="YOUR_RECAPTCHA_SITE_KEY_HERE"
RECAPTCHA_SECRET_KEY="YOUR_RECAPTCHA_SECRET_KEY_HERE"
